{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "AegisChain Supply Chain Trust Overview",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 80, "gradientMode": "none" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Admission Latency Percentiles (p50, p95, p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(aegischain_admission_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50 Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(aegischain_admission_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Latency",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(aegischain_admission_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99 Latency",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "fillOpacity": 80 },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Admission Decisions Rate (Allow vs Deny)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(aegischain_engine_decisions_total{verdict=\"allow\"}[5m]))",
          "legendFormat": "Admitted (Allow)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(aegischain_engine_decisions_total{verdict=\"deny\"}[5m]))",
          "legendFormat": "Blocked (Deny)",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Cache & Performance Signals",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.6 },
              { "color": "green", "value": 0.85 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 10 },
      "id": 3,
      "options": { "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Digest & Signature Cache Hit Ratio",
      "type": "gauge",
      "targets": [
        {
          "expr": "sum(rate(aegischain_cache_hits_total[5m])) / (sum(rate(aegischain_cache_hits_total[5m])) + sum(rate(aegischain_cache_misses_total[5m])) + 0.0001)",
          "legendFormat": "Cache Hit Ratio",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 10 },
      "id": 4,
      "title": "Risk Scorer Service Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(aegischain_scorer_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "Scorer p95",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 10 },
      "id": 5,
      "title": "Verification Failure Reasons",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(aegischain_verify_failures_total[5m])) by (reason)",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 10 },
      "id": 6,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Decision Ledger Length (Records)",
      "type": "stat",
      "targets": [
        {
          "expr": "aegischain_ledger_records_total",
          "legendFormat": "Ledger Records",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["aegischain", "supply-chain", "security", "slsa"],
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "AegisChain: Software Supply Chain Trust Operations",
  "uid": "aegischain-ops",
  "version": 1
}
